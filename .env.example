# Copy to .env and fill in. Never commit .env.
# Prefilled with Apache's public Server/DC instance (anonymous, no real
# credentials needed) so `uv run flowbi ...` works out of the box - swap in
# your own Jira's values to point this at a real deployment.
FLOWBI_JIRA_BASE_URL=https://issues.apache.org/jira
# Cloud auth:
FLOWBI_JIRA_EMAIL=
FLOWBI_JIRA_API_TOKEN=
# Server/DC auth:
FLOWBI_JIRA_PAT=dummy-anonymous
# Optional: scope extraction to one project key (e.g. KAFKA)
FLOWBI_JIRA_PROJECT=KAFKA
# Optional: ISO datetime floor for `extract issues`' first run (default: epoch, i.e. everything)
FLOWBI_JIRA_INCREMENTAL_START=
# Phase 2: Postgres DSN for `--destination postgres` (docs/phase2-postgres-design.md).
# Points at the local docker-compose Postgres (`docker compose up -d`) by default.
# Host port 5433, not 5432 - this machine already runs an unrelated postgres
# container on 5432 for a different project.
FLOWBI_POSTGRES_DSN=postgresql://flowbi:flowbi@localhost:5433/openflowbi

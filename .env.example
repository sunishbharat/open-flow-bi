# Copy to .env and fill in. Never commit .env.
# Prefilled with Apache's public Server/DC instance (anonymous, no real
# credentials needed) so `uv run flowbi ...` works out of the box - swap in
# your own Jira's values to point this at a real deployment.
FLOWBI_JIRA_BASE_URL=https://issues.apache.org/jira
# Cloud auth:
FLOWBI_JIRA_EMAIL=
FLOWBI_JIRA_API_TOKEN=
# Server/DC auth:
FLOWBI_JIRA_PAT=dummy-anonymous
# Optional: scope extraction to one project key (e.g. KAFKA)
FLOWBI_JIRA_PROJECT=KAFKA
# Optional: ISO datetime floor for `extract issues`' first run (default: epoch, i.e. everything)
FLOWBI_JIRA_INCREMENTAL_START=
# Optional: stable slug identifying this Jira instance, part of every Postgres
# primary key from M7.2 on (docs/phase2-postgres-design.md §7). Default:
# derived from FLOWBI_JIRA_BASE_URL's host, e.g. issues-apache-org.
FLOWBI_JIRA_INSTANCE_ID=
# Phase 2: Postgres DSN for `--destination postgres` (docs/phase2-postgres-design.md).
# Points at the local docker-compose Postgres (`docker compose up -d`) by default.
# Host port 5433, not 5432 - this machine already runs an unrelated postgres
# container on 5432 for a different project.
FLOWBI_POSTGRES_DSN=postgresql://flowbi:flowbi@localhost:5433/openflowbi
# Phase 4: password for the cube_reader role (migrations/sql/roles.sql) - the
# docker-compose `cube` service authenticates to Postgres as this role.
# docs/phase4-cube-dashboard-design.md §5.
CUBE_READER_PW=
# Phase 4 (M9a.2): credentials for Cube's own Postgres-wire SQL API (not the
# same as CUBE_READER_PW above, which is Cube's connection *to* Postgres) -
# what Superset authenticates with when connecting to Cube.
CUBE_SQL_USER=superset
CUBE_SQL_PASSWORD=
# Phase 4 (M9a.2): local Superset instance. Generate a real secret with
# `python -c "import secrets; print(secrets.token_urlsafe(42))"` - Superset
# refuses to run with a default/example key.
SUPERSET_SECRET_KEY=
SUPERSET_ADMIN_PW=

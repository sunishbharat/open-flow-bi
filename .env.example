# Copy to .env and fill in. Never commit .env.
# Prefilled with Apache's public Server/DC instance (anonymous, no real
# credentials needed) so `uv run flowbi ...` works out of the box - swap in
# your own Jira's values to point this at a real deployment.
FLOWBI_JIRA_BASE_URL=https://issues.apache.org/jira
# Cloud auth:
FLOWBI_JIRA_EMAIL=
FLOWBI_JIRA_API_TOKEN=
# Server/DC auth:
FLOWBI_JIRA_PAT=dummy-anonymous
# Optional: scope extraction to one project key (e.g. KAFKA)
FLOWBI_JIRA_PROJECT=KAFKA
# Optional: ISO datetime floor for `extract issues`' first run (default: epoch, i.e. everything)
FLOWBI_JIRA_INCREMENTAL_START=
# Optional: stable slug identifying this Jira instance, part of every Postgres
# primary key. Default: derived from FLOWBI_JIRA_BASE_URL's host, e.g.
# issues-apache-org.
FLOWBI_JIRA_INSTANCE_ID=
# Optional: "cloud" or "server". Skips the unauthenticated /serverInfo probe - set it
# when the Jira host enforces mTLS or sits behind a proxy that resets that probe.
# FLOWBI_JIRA_DEPLOYMENT=server
# Optional: mTLS client certificate + private key, each a base64-encoded PEM, set
# together. Only for Jira instances that require a client certificate. From a .pfx:
#   openssl pkcs12 -in svc.pfx -clcerts -nokeys -out cert.pem -legacy
#   openssl pkcs12 -in svc.pfx -nocerts -nodes  -out key.pem  -legacy
#   base64 -w0 cert.pem   /   base64 -w0 key.pem
# FLOWBI_JIRA_CLIENT_CERT_B64=
# FLOWBI_JIRA_CLIENT_KEY_B64=
# Postgres DSN for `--destination postgres`. Points at the local docker-compose
# Postgres (`docker compose up -d`) by default. Host port 5433 avoids clashing
# with a local Postgres on 5432.
FLOWBI_POSTGRES_DSN=postgresql://flowbi:flowbi@localhost:5433/openflowbi
# Password for the cube_reader role (migrations/sql/roles.sql) - the
# docker-compose `cube` service authenticates to Postgres as this role.
CUBE_READER_PW=
# Credentials for Cube's own Postgres-wire SQL API (not the
# same as CUBE_READER_PW above, which is Cube's connection *to* Postgres) -
# what Superset authenticates with when connecting to Cube.
CUBE_SQL_USER=superset
CUBE_SQL_PASSWORD=
# Local Superset instance. Generate a real secret with
# `python -c "import secrets; print(secrets.token_urlsafe(42))"` - Superset
# refuses to run with a default/example key.
SUPERSET_SECRET_KEY=
SUPERSET_ADMIN_PW=

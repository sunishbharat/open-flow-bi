# Markdown - ignore all, keep only README and tracked runtime assets
docs/
*.md
*.exe
!README.md

# Python
__pycache__/
*.py[cod]
*.egg-info/
htmlcov/

# TOML - ignore all except pyproject.toml
*.toml
!pyproject.toml

# Ignore all dotfiles and dot-directories by default
.*
!.gitignore
!.env.example
!.github/
!.dockerignore
!CONTRIBUTING.md
!.python-version

# Runtime data (learned conventions, caches, session-sharded convention files)
data/
data/conventions/

# Pipeline runtime artifacts (dlt filesystem/DuckDB output, local secrets)
out/
*.duckdb
*.duckdb.wal



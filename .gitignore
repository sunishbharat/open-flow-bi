# Secrets and machine-specific files (also covered by the dotfile rule below,
# listed explicitly so they stay ignored if that rule ever changes)
docs/
*.md
.env
*.pem
*.log

# Local binaries (e.g. an optional duckdb.exe at the repo root)
*.exe
!README.md

# Python
__pycache__/
*.py[cod]
*.egg-info/
htmlcov/

# TOML - ignore all except pyproject.toml (dlt's local secrets.toml/config.toml
# can hold credentials)
*.toml
!pyproject.toml

# Ignore all dotfiles and dot-directories by default: .venv, tool caches
# (.pytest_cache, .mypy_cache, .ruff_cache), dlt state (.dlt), Cube Store data
# (cube/.cubestore)
.*
!.gitignore
!.env.example
!.github/
!.dockerignore
!.gitattributes
!.python-version

# Runtime data
data/

# Pipeline runtime artifacts (dlt filesystem/DuckDB output)
out/
*.duckdb
*.duckdb.wal
